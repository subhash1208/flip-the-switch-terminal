# Optional pins: docker build --build-arg NODE18_DIGEST=sha256:<index digest> --build-arg NODE22_DIGEST=sha256:<index digest>
ARG NODE18_DIGEST=
ARG NODE22_DIGEST=
# pin to the MULTI-ARCH INDEX digest (works on arm64 Mac and amd64 WSL2) once resolved; UNVERIFIED until pinned
FROM node:22-bookworm-slim${NODE22_DIGEST:+@${NODE22_DIGEST}} AS node22
FROM node:18-bookworm-slim${NODE18_DIGEST:+@${NODE18_DIGEST}}
# Ablation only: Node 22 binary beside the Node 18 runtime, used via --entrypoint /opt/node22/bin/node
COPY --from=node22 /usr/local/bin/node /opt/node22/bin/node
WORKDIR /app
