{
  "mcpServers": {
    "switch-docs": {
      "type": "http",
      "url": "https://docs.switchagents.ai/mcp"
    },
    "switch-trust-mcp": {
      "command": "uvx",
      "args": ["switch-trust-mcp"],
      "env": {
        "SWITCH_TRUST_API_KEY": "${SWITCH_TRUST_API_KEY}",
        "SWITCH_TRUST_INSTANCE": "https://app.switchagents.ai"
      },
      "disabled": true
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "d:/Projects/flip-the-switch-terminal/switch-hackathon-knowledge-graph.jsonl"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}
