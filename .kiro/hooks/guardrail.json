{
  "version": "v1",
  "hooks": [
    {
      "name": "Secret Guardrail",
      "trigger": "PreToolUse",
      "description": "Blocks tool calls that touch secret material (.env, keys, credentials, env dumps). Exit 2 = block.",
      "matcher": "Read|Write|Edit|MultiEdit",
      "action": {
        "type": "command",
        "command": "python \".kiro/hooks/scripts/kiro-guardrail.py\" 2>nul || python3 \".kiro/hooks/scripts/kiro-guardrail.py\"",
        "timeout": 10
      }
    }
  ]
}
